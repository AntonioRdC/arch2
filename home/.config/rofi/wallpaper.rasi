configuration {
    show-icons: true;
    font: "JetBrainsMono Nerd Font 10";
}

@theme "catppuccin-mocha"

window {
    width: 100%;
    height: 36em;
    transparency: "real";
    border: 0;
    border-radius: 22px;
    background-color: #1e1e2ed9;
}

mainbox {
    orientation: horizontal;
    children: [ left-space, listview, right-space ];
    background-color: transparent;
}

left-space, right-space {
    width: 2em;
    expand: false;
    background-color: transparent;
}

listview {
    columns: 6;
    lines: 1;
    spacing: 2em;
    padding: 3em 1em;
    cycle: true;
    scrollbar: false;
    dynamic: true;
    fixed-height: true;
    fixed-columns: true;
    background-color: transparent;
}

element {
    orientation: vertical;
    spacing: 0.6em;
    padding: 0.6em;
    border: 0;
    border-radius: 22px;
    border-color: transparent;
    background-color: transparent;
    text-color: @text;
}

element selected.normal {
    background-color: @surface1;
    text-color: @text;
}

element-icon {
    size: 25em;
    border-radius: 0;
    background-color: transparent;
}

element-text {
    horizontal-align: 0.5;
    padding: 0.5em;
    background-color: transparent;
    text-color: @subtext1;
}

textbox {
    background-color: transparent;
    text-color: @text;
}
