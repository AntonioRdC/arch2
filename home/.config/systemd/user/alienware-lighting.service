[Unit]
Description=Restore Alienware keyboard lighting at login
PartOf=graphical-session.target
After=graphical-session-pre.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=oneshot
ExecStart=%h/.local/bin/alien-light restore --if-enabled
RemainAfterExit=yes
Restart=on-failure
RestartSec=5
TimeoutStartSec=50

[Install]
WantedBy=graphical-session.target
