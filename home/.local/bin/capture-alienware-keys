#!/usr/bin/env bash

set -u
shopt -s nullglob

if ! command -v evtest >/dev/null 2>&1; then
    printf '%s\n' 'evtest não está instalado.'
    printf '%s\n' 'Instale com: sudo pacman -S --needed evtest'
    exit 1
fi

declare -a devices=()
declare -a names=()

for name_file in /sys/class/input/event*/device/name; do
    name=$(<"$name_file")
    case "$name" in
        'Dell WMI hotkeys'|'AT Translated Set 2 keyboard'|'DELL Technologies Keyboard'|'Intel HID events'|'Intel HID 5 button array')
            event_dir=${name_file%/device/name}
            devices+=("/dev/input/${event_dir##*/}")
            names+=("$name")
            ;;
    esac
done

if ((${#devices[@]} == 0)); then
    printf '%s\n' 'Nenhum dispositivo de teclado compatível foi encontrado.'
    printf '%s\n' 'Confira se está executando o script no sistema instalado, não dentro de um container.'
    exit 1
fi

printf '%s\n' 'Dispositivos monitorados:'
for i in "${!devices[@]}"; do
    printf '  %s — %s (%s)\n' "$((i + 1))" "${names[i]}" "${devices[i]}"
done

printf '%s\n' ''
printf '%s\n' 'Agora pressione cada tecla uma vez: F6, Fn+Home e M1–M4.'
printf '%s\n' 'Também teste as teclas com e sem Fn. Para terminar, pressione Ctrl+C.'
printf '%s\n' ''

if ! sudo -v; then
    printf '%s\n' 'Não foi possível autenticar com sudo.'
    exit 1
fi

log="$HOME/alienware-key-events-$(date +%Y%m%d-%H%M%S).log"
pids=()

cleanup() {
    trap - INT TERM EXIT
    for pid in "${pids[@]}"; do
        kill "$pid" 2>/dev/null || true
        pkill -TERM -P "$pid" 2>/dev/null || true
    done
    printf '\nEventos salvos em: %s\n' "$log"
}

trap cleanup INT TERM EXIT

for i in "${!devices[@]}"; do
    (
        sudo evtest "${devices[i]}" 2>&1 |
            awk -v label="${names[i]}" \
                '/Event:.*\(EV_KEY\)|Event:.*\(EV_MSC\)/ {
                    print "[" label "] " $0
                    fflush()
                }' |
            tee -a "$log"
    ) &
    pids+=("$!")
done

wait
